# Copy to .env and adjust. Never commit .env.
# Bootstrap secrets live here; operational config belongs in the database.

APP_NAME="Social Marketing Agent"
APP_VERSION="0.1.0"
ENVIRONMENT=local

# Infra. Non-default ports so this project cannot collide with another
# project's Postgres or Redis running on the same machine.
# Runtime: restricted role, row-level security APPLIES.
APP_DATABASE_URL=postgresql+asyncpg://sma_app:sma_app@localhost:5435/sma
# Migrations only: table owner. Never used by the running application.
DATABASE_URL=postgresql+asyncpg://sma:sma@localhost:5435/sma
REDIS_URL=redis://localhost:6381/0

# Browser origins permitted to call the API.
CORS_ORIGINS=["http://localhost:3100"]

# --- Added in later phases; unset means the fake provider is used, never a
# --- silent call to a paid service. See docs/BUILD_ORDER.md.
# Phase 2
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# Phase 4
# TAVILY_API_KEY=
# Phase 8
# RESEND_API_KEY=
# Phase 12
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# Frontend (public -- must contain nothing secret)
NEXT_PUBLIC_API_URL=http://localhost:8100

# ---------------------------------------------------------------------------
# PLATFORM CREDENTIALS (publishing)
# Encrypts the access tokens in `platform_connections` with AES-256-GCM. Generate
# with `openssl rand -base64 32`.
#
# Unset, connecting a platform REFUSES rather than storing a token in plaintext.
# `ephemeral` uses an in-process vault instead: the column holds only a handle, so a
# table dump carries no credential — but nothing survives a restart, which makes it
# right for local development and useless in production.
#
# Rotating this invalidates every stored credential; the fix is to re-connect the
# accounts, and the error message says so.
# ---------------------------------------------------------------------------
PLATFORM_CREDENTIAL_KEY=ephemeral

# The Meta app behind Facebook + Instagram OAuth (`services/platform_oauth_meta.py`).
# META_APP_ID is your app's id from developers.facebook.com; META_APP_SECRET is its
# App Secret from the same screen. One integration serves both platforms: Instagram
# publishing runs through the Graph API against an IG Business account linked to a
# Facebook Page, authorised by a Facebook login.
#
# BOTH must be set. With either one absent, connecting Facebook or Instagram uses
# FakeOAuthProvider -- no network, no real grant -- and `GET /api/v1/connections` says
# so in `oauth.message`. Only one of the two set is treated as absent: a half-configured
# app would send a customer through a real consent dialog and then fail the exchange,
# leaving a live grant we never recorded.
#
# Setting these does NOT make publishing work. Posting to a Page or an Instagram
# Business account needs Meta App Review; these credentials buy the connection
# lifecycle (consent, long-lived token, renewal, de-authorisation). See docs/CHANNELS.md
# sections 2-3.
#
# The redirect URI registered in the Meta app must match the callback this API serves:
# {PUBLIC_BASE_URL}/api/v1/connections/{facebook|instagram}/callback
# META_APP_ID=
# META_APP_SECRET=

# The LinkedIn app behind LinkedIn OAuth (`services/platform_oauth_linkedin.py`).
# Create an app at linkedin.com/developers, associate it with a Company Page, and take
# the Client ID and Client Secret from its Auth tab.
#
# Absence means the fake provider, exactly as with Meta: half-configured counts as
# absent, because an id with no secret would swap a fake that works for a real provider
# that fails at the callback -- after the member has already granted consent.
#
# Scopes: `openid` and `profile` for the identity read, `w_member_social` to post as the
# authenticated member. Posting as a COMPANY PAGE needs `w_organization_social`, which
# needs Marketing Developer Platform approval -- LinkedIn's own queue, refusable. These
# credentials buy the connection lifecycle, not the right to publish for other people.
#
# LinkedIn also issues a refresh token only to approved applications. Without that
# approval a connection cannot be renewed and the owner has to reconnect; the refusal
# says exactly that rather than retrying.
#
# The redirect URI registered in the LinkedIn app must match the callback this API
# serves: {PUBLIC_BASE_URL}/api/v1/connections/linkedin/callback
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Transactional email. Absent, every send is SIMULATED and the outcome says so rather
# than reporting a delivery that did not happen.
# RESEND_API_KEY=

# Who EXPORT's owner notice comes FROM (the `notify.owner` actuator). Needed as well as
# the key, and separately: the actuator refuses a notice with no sender identity BEFORE
# the fake/real branch, so a run with no `OWNER_NOTICE_FROM` reports a named "cannot send
# an owner notice" note rather than quietly not telling anybody their run finished.
#
# The RECIPIENT is never configured here. It is resolved from the authenticated account
# (`businesses.owner_id -> users.email`), because taking it from the crawled Business DNA
# would make a page we do not control the authority over where our operational mail goes.
# OWNER_NOTICE_FROM=
